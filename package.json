{
  "name": "stellar-agent-guard-sdk",
  "version": "0.1.1",
  "description": "Pre-flight policy interception and guardrails for AI agents on Stellar Soroban smart accounts.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "stellar",
    "soroban",
    "ai-agents",
    "guardrails",
    "spend-limits",
    "custom-account",
    "smart-accounts",
    "policy-engine",
    "pre-flight",
    "agent-auth",
    "transaction-signing",
    "cost-pre-checks",
    "on-chain-telemetry",
    "allowlist",
    "per-transaction-limits",
    "sac-token",
    "transfer-from",
    "stellar-soroban",
    "agent-frameworks",
    "langchain",
    "elizaos",
    "mcp",
    "model-context-protocol",
    "integration-bridge",
    "dex",
    "lending",
    "protocol-calls",
    "window-enforcement",
    "pause-state",
    "auth-context",
    "typescript",
    "esm",
    "node-24"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stellar-agent-guard/stellar-agent-guard-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/stellar-agent-guard/stellar-agent-guard-sdk/issues"
  },
  "homepage": "https://github.com/stellar-agent-guard/stellar-agent-guard-sdk#README",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check:strict-ratchet": "node scripts/check-strict-ratchet.mjs",
    "lint": "eslint .",
    "test": "node --import tsx scripts/run-tests.ts unit",
    "test:unit": "node --import tsx scripts/run-tests.ts unit",
    "test:watch": "node --import tsx scripts/run-tests.ts unit --watch",
    "test:integration": "node --import tsx scripts/run-tests.ts integration",
    "test:all": "node --import tsx scripts/run-tests.ts all",
    "test:coverage": "node --import tsx scripts/run-tests.ts all --coverage",
    "test:coverage:floor": "c8 --check-coverage --include=src/preflight.ts --include=src/policy.ts --include=src/invoke.ts node --import tsx scripts/run-tests.ts unit",
    "test:exports": "node --import tsx scripts/check-export-map.ts",
    "test:types:packed": "node --import tsx scripts/check-packed-types.ts",
    "test:browser": "node scripts/check-browser-entry.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "test:smoke": "node --input-type=module -e \"import('./dist/index.js').then(m => { if (!m.PreFlightInterceptor) throw new Error('Missing PreFlightInterceptor'); console.log('ESM export-map resolution smoke test passed: ' + Object.keys(m).length + ' exports found'); })\"",
    "bench": "node --import tsx benches/check-decode.bench.ts",
    "bench:preflight": "node --import tsx scripts/bench-preflight-encode.ts",
    "inspect": "node scripts/inspect-deployment.ts",
    "deploy:phase2": "node scripts/deploy-phase2-instance.ts",
    "sync:fixtures": "node --import tsx scripts/sync-contract-fixtures.ts",
    "vendor:refresh": "node --import tsx scripts/vendor-fixtures.ts",
    "policy-schema:bootstrap": "node --import tsx -e \"import { bootstrapAheadOfUpstream } from './scripts/vendor-fixtures.ts'; import { readFileSync } from 'node:fs'; const r = bootstrapAheadOfUpstream(readFileSync('scripts/policy-schema.bootstrap.json', 'utf8')); console.log('vendored', r.artifact.outputPath, 'sha256:' + r.digest);\"",
    "capture:rpc-fixtures": "node --import tsx scripts/capture-rpc-fixtures.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "c8": "^12.0.0",
    "eslint": "^10.10.0",
    "tinybench": "^6.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0"
  }
}
